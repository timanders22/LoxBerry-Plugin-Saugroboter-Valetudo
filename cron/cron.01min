#!/bin/sh
# Saugroboter (Valetudo) - minutlicher Cron (Status, Meldungen, MQTT)
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Seit 1.0.4 liegt cron.php dort und nicht mehr im unangemeldeten HTML-Ordner.
#
# Bis 1.0.14 lautete die Zeile
#     php "<bin-Ordner des Plugins>/cron.php" >/dev/null 2>&1
# und verschluckte damit BEIDE Abbruchmeldungen von cron.php - auch die,
# die sagt, dass die Bibliothek nicht gefunden wurde. Ein Cron, der jede
# Minute ins Leere laeuft, sah genauso aus wie einer, der arbeitet.
#
# Die Fehlerausgabe geht deshalb in die Protokolldatei des Plugins. Die
# normale Ausgabe ("OK") bleibt unterdrueckt - sie stuende sonst jede
# Minute im Systemprotokoll.

# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

BIN="REPLACELBPBINDIR"

# Den Protokollpfad ABLEITEN statt auf eine Umgebungsvariable zu setzen:
# ob LoxBerry LBPLOGDIR im Cron-Zusammenhang setzt, ist hier nicht gemessen.
# $BIN ist <home>/bin/plugins/<ordner> - also drei Ebenen bis <home>.
ORDNER=$(basename "$BIN")
HOME_LB=$(cd "$BIN/../../.." 2>/dev/null && pwd)
# EIGENE Datei fuer die Fehlerausgabe der Schale.
#
# Bis 1.1.3 ging sie nach robo.log - also in genau die Datei, die das Plugin
# selbst in einem festen Format fuehrt und bei 512 kB kuerzt. Im Reiter
# Protokoll standen danach zwei Formate gemischt, und eine Kuerzung durch das
# Plugin konnte eine Schalenmeldung mitnehmen. Der Reiter Protokoll nennt
# beide Dateien.
if [ -n "$HOME_LB" ] && [ -d "$HOME_LB/log/plugins/$ORDNER" ]; then
    LOG="$HOME_LB/log/plugins/$ORDNER/cron.log"
else
    LOG="/tmp/$ORDNER-cron.log"
fi
# 1.1.27 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 1.1.26 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
( : >>"$LOG" ) 2>/dev/null || LOG=/dev/null

if [ ! -f "$BIN/cron.php" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Cron: $BIN/cron.php fehlt - Platzhalter nicht ersetzt?" >> "$LOG"
    exit 1
fi

PHP=$(command -v php 2>/dev/null)
[ -n "$PHP" ] || PHP=/usr/bin/php
if [ ! -x "$PHP" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Cron: kein PHP gefunden." >> "$LOG"
    exit 1
fi

# Gruppe 28 (1.1.23, S16; Bauform Abfuhr 1.4.26 / Ferien 1.2.28, Root-Abwurf wie ACTiKamera 1.9.32): cron.log ab
# 256 kB auf die letzten 300 Zeilen kappen (Form Bruecke 1.0.1), ueber eine Nebendatei. Ruft jemand diese Datei als
# root auf, laeuft cron.php als loxberry (der LoxBerry-Cron selbst startet als loxberry, /etc/cron.d/lbdefaults -
# der Zweig ist eine Haertung). Die Upgrade-Marke prueft bin/cron.php selbst (S19).
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
    tail -n 300 "$LOG" > "$LOG.neu" 2>/dev/null && mv -f "$LOG.neu" "$LOG"
fi
if command -v su >/dev/null 2>&1 && [ "$(id -u)" = "0" ]; then
    su loxberry -s /bin/sh -c '"$0" "$1/cron.php"' "$PHP" "$BIN" >/dev/null 2>>"$LOG"
else
    "$PHP" "$BIN/cron.php" >/dev/null 2>>"$LOG"
fi
