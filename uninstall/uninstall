#!/bin/bash
# Saugroboter (Valetudo) - uninstall
# command <TEMPFILE> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
#
# LoxBerry raeumt die Plugin-Ordner weg und entfernt den Cron-Eintrag.
# Zwei Dinge bleiben sonst liegen:
#
#   1. config/plugins/<ordner>.backup.json
#      Die Sicherung liegt bewusst NEBEN dem Konfigordner, damit sie Update
#      und Neuinstallation uebersteht (ro_paths()['backup']). Beim
#      Deinstallieren ist genau das falsch: darin stehen die Adressen der
#      Roboter, das Aktionstoken des unangemeldeten Endpunkts und - falls
#      eingerichtet - die Anmeldung an Valetudo.
#   2. /tmp/<ordner>
#      Zwischenspeicher: Zustand je Roboter, Merker fuer stumme Geraete,
#      Ansagen, MQTT-Signaturen, Lebenszeichen. /tmp ist auf dem LoxBerry
#      eine Ramdisk, der Ordner verschwindet also spaetestens beim naechsten
#      Neustart - bis dahin stuende er aber da.

PDIR=$3
[ -n "$PDIR" ] || PDIR="saugrobo"
BASE="${5:-$LBHOMEDIR}"
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# Dieses Skript liegt unter <home>/data/plugins/<ordner>/uninstall/
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(cd "$(dirname "$(readlink -f "$0")")/../../../.." 2>/dev/null && pwd)
fi

BK="$BASE/config/plugins/$PDIR.backup.json"
TMP="/tmp/$PDIR"

if [ -f "$BK" ]; then
    rm -f "$BK" && echo "<OK> Sicherung der Konfiguration entfernt: $PDIR.backup.json"
    echo "<INFO> Adressen der Roboter und das Aktionstoken sind damit fort."
else
    echo "<INFO> Keine Sicherung ausserhalb des Plugin-Ordners vorhanden."
fi

if [ -d "$TMP" ]; then
    rm -rf "$TMP" && echo "<OK> Zwischenspeicher $TMP entfernt."
fi
# Bis 1.0.14 lag er unabhaengig vom Ordnernamen fest unter /tmp/saugrobo.
if [ "$PDIR" != "saugrobo" ] && [ -d "/tmp/saugrobo" ]; then
    rm -rf "/tmp/saugrobo" && echo "<OK> Alter Zwischenspeicher /tmp/saugrobo entfernt."
fi

echo "<INFO> Valetudo laeuft auf dem Roboter selbst und bleibt unberuehrt."
echo "<WARNING> Im MQTT-Broker koennen Werte stehen bleiben."
echo "<INFO> Das Plugin veroeffentlicht unter dem eingestellten Themenpraefix"
echo "<INFO> (Vorgabe: saugrobo/...). Zum Aufraeumen: LoxBerry -> System ->"
echo "<INFO> MQTT Gateway."
exit 0
