#!/bin/bash
# Saugroboter (Valetudo) - uninstall
# command <TEMPFILE> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
#
# LoxBerry raeumt die Plugin-Ordner weg und entfernt den Cron-Eintrag.
# Drei Dinge bleiben sonst liegen:
#
#   1. config/plugins/<ordner>.backup.json
#      Die Sicherung liegt bewusst NEBEN dem Konfigordner, damit sie Update
#      und Neuinstallation uebersteht (ro_paths()['backup']). Beim
#      Deinstallieren ist genau das falsch: darin stehen die Adressen der
#      Roboter, das Aktionstoken des unangemeldeten Endpunkts und - falls
#      eingerichtet - die Anmeldung an Valetudo.
#   2. /tmp/<ordner>
#      Zwischenspeicher: Zustand je Roboter, Merker fuer stumme Geraete,
#      Ansagen, MQTT-Signaturen, Lebenszeichen. /tmp ist auf dem LoxBerry
#      eine Ramdisk, der Ordner verschwindet also spaetestens beim naechsten
#      Neustart - bis dahin stuende er aber da.
#   3. Die zurueckbehaltenen MQTT-Themen der Linie im Broker. Nach jedem
#      Neustart von Broker oder Gateway bekaeme der Miniserver sie wieder -
#      von einem Plugin, das es nicht mehr gibt.

# ---------- Gruppe 2 (1.1.22): nur die EIGENE Deinstallation ----------
# plugininstall.pl ruft beim Deinstallieren JEDES data/system/uninstall/<NAME>* auf und uebergibt als $2 den NAMEN
# des deinstallierten Plugins (am Geraet gemessen 08.10.2026: zigbee2mqtt riss zigbee2mqttng mit). Gehoert der Name
# nicht zu diesem Plugin, wird nichts angefasst - weder die Befehlsbruecke noch eine Datei (Entwurf sv 3.3).
if [ -n "$2" ] && [ "$2" != "saugrobo" ]; then
    echo "<INFO> Deinstallation von '$2' - betrifft Saugroboter (Valetudo) nicht, nichts getan."
    exit 0
fi

PDIR=$3
[ -n "$PDIR" ] || PDIR="saugrobo"
BASE="${5:-$LBHOMEDIR}"
# Der Installer legt dieses Skript als <home>/data/system/uninstall/<ordner>
# ab und uebergibt die LoxBerry-Wurzel als fuenftes Argument
# (plugininstall.pl:1158 und :1577, am Geraet nachgesehen 17.09.2026).
# Bis 1.1.9 fiel das Skript ohne beides fest drei Ebenen ueber seinem
# Ablageort auf - ohne general.json: in einem fremden Baum loeschte es
# dessen Zweitschrift, ohne jede Wurzel die Datei
# /config/plugins/<ordner>.backup.json ab der Laufwerkswurzel, und es
# meldete Vollzug (in WSL gemessen, Pruefung-Saugroboter-Valetudo-1.1.10,
# Faelle H3, H5 und C12).
# Die Wurzel: $5 (vom Installer) oder $LBHOMEDIR, wenn dort config/plugins
# und data/plugins liegen - sonst vom eigenen Ablageort AUFWAERTS SUCHEN, bis
# ein Verzeichnis config/plugins, data/plugins UND config/system/general.json
# traegt. Keine feste Ebenenzahl und kein fest verdrahteter Systempfad danach.
# general.json ist die Bedingung aus dem Raumklima-Vorfall (Regeln/06): ein
# LoxBerry hat die Datei immer, ein Pruefstandsrest nie. Findet sich nichts,
# wird GEWARNT statt vollzogen. Bauart AWM-Abfuhr 1.4.13; gemessen in WSL,
# Pruefung-Saugroboter-Valetudo-1.1.10 (Faelle H und C).
ro_wurzel_suchen() {
    ro_v=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    ro_i=0
    while [ -n "$ro_v" ] && [ "$ro_v" != "/" ] && [ "$ro_i" -lt 8 ]; do
        if [ -d "$ro_v/config/plugins" ] && [ -d "$ro_v/data/plugins" ] \
           && [ -f "$ro_v/config/system/general.json" ]; then
            echo "$ro_v"
            return 0
        fi
        ro_v=$(dirname "$ro_v")
        ro_i=$((ro_i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    BASE=$(ro_wurzel_suchen "$(dirname "$(readlink -f "$0")")") || BASE=""
fi
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden: weder als"
    echo "<WARNING> fuenftes Argument noch in \$LBHOMEDIR, und oberhalb von"
    echo "<WARNING> $(dirname "$(readlink -f "$0")") traegt kein Verzeichnis"
    echo "<WARNING> config/plugins, data/plugins und config/system/general.json."
    echo "<WARNING> Es wurde NICHTS geloescht."
    exit 1
fi

# ---------- Gruppe 2 (1.1.22): die Befehlsbruecke anhalten und ihre Zugangsdaten entfernen ----------
# Vor dem Abraeumen der MQTT-Themen (Entwurf sv 3.3). Bauform vb_g1_bruecke_bau/beispiel/uninstall/uninstall (Entwurf
# gemeinsam 2.9): stop beendet Dienst UND mosquitto_sub (auch ein verwaistes), danach argumentweise nachzaehlen, die
# Optionsdateien (Broker-Kennwort) ueberschreiben, den Ordner data/plugins/<ordner>/befehle entfernen und
# nachzaehlen. Im Broker bleibt nichts: die Quittungen sind nicht retained.
BBSH="$BASE/bin/plugins/$PDIR/befehlsbruecke.sh"
BBPHP="$BASE/bin/plugins/$PDIR/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PDIR/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop
fi
BBREST=0
for D in /proc/[0-9]*; do
    mapfile -d '' -t BBA 2>/dev/null < "$D/cmdline" || continue
    if [ "${#BBA[@]}" -eq 2 ] && [ "${BBA[1]}" = "$BBPHP" ] && [[ "${BBA[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${D#/proc/}" 2>/dev/null
        BBREST=$((BBREST + 1))
    fi
done
BBABOS=0
for D in /proc/[0-9]*; do
    read -r BBC 2>/dev/null < "$D/comm" || continue
    [ "$BBC" = "mosquitto_sub" ] || continue
    mapfile -d '' -t BBE 2>/dev/null < "$D/environ" || continue
    for BBX in "${BBE[@]}"; do
        if [ "$BBX" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${D#/proc/}" 2>/dev/null; BBABOS=$((BBABOS + 1)); fi
    done
done
[ "$BBREST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BBREST Dienst(e) erst mit kill -9 beendet."
[ "$BBABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BBABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for BBF in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$BBF" ]; then
            BBN=$(stat -c %s "$BBF" 2>/dev/null || echo 64)
            head -c "$BBN" /dev/zero > "$BBF" 2>/dev/null
        fi
    done
    rm -rf "$BBDIR"
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
else
    echo "<OK> Befehlsbruecke angehalten, Zugangsdaten der Befehlsbruecke entfernt."
fi

# Die zurueckbehaltenen MQTT-Themen der Linie leeren - VOR dem Loeschen, denn
# das Praefix steht in der Konfiguration. Bis 1.1.9 blieben sie nach dem
# Deinstallieren im Broker stehen, und diese Datei sagte nur, man solle sie
# von Hand aufraeumen (in WSL gemessen, Pruefung-Saugroboter-Valetudo-1.1.10,
# Faelle U1 bis U8). Geleert wird ueber den Weg der Linie, den UDP-Eingang
# des Gateways, und beim Broker nachgelesen (ro_mqtt_leeren() in
# webfrontend/html/robo_lib.php; Bauart AWM-Abfuhr 1.4.13). Als loxberry,
# nicht als root; stdin geschlossen, damit su nie auf eine Eingabe wartet.
RO_CRON="$BASE/bin/plugins/$PDIR/cron.php"
if command -v php >/dev/null 2>&1 && [ -f "$RO_CRON" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
            timeout 120 php "$RO_CRON" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 120 php "$RO_CRON" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder cron.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

BK="$BASE/config/plugins/$PDIR.backup.json"
TMP="/tmp/$PDIR"

# I4 (Durchgang 01.10.2026): "fort" nur, wenn die Datei wirklich weg ist.
# Bis 1.1.11 stand der Satz unbedingt da - auch nach "Permission denied", und
# die Zweitschrift lag noch (in WSL gemessen, Installer-Pruefer Fall E4).
# I1: dazu die beiseitegelegte Zweitschrift (.alt) einer Neuinstallation und
# die Marke eines abgebrochenen Updates.
RO_REST=""
for RO_D in "$BK" "$BK.alt" "$BASE/data/plugins/$PDIR.upgrade_laeuft"; do
    if [ -e "$RO_D" ] || [ -L "$RO_D" ]; then
        rm -f "$RO_D" 2>/dev/null
        if [ -e "$RO_D" ] || [ -L "$RO_D" ]; then
            RO_REST="$RO_REST $RO_D"
        else
            echo "<OK> Entfernt: $(basename "$RO_D")"
        fi
    fi
done
if [ -n "$RO_REST" ]; then
    echo "<WARNING> Nicht zu entfernen, bitte von Hand loeschen (darin stehen Roboteradressen und Aktionstoken):$RO_REST"
elif [ ! -e "$BK.alt" ]; then
    echo "<INFO> Ausserhalb des Plugin-Ordners liegt keine Sicherung mehr - Adressen der Roboter und Aktionstoken sind fort."
fi

if [ -d "$TMP" ]; then
    rm -rf "$TMP" && echo "<OK> Zwischenspeicher $TMP entfernt."
fi
# Die Rueckfall-Protokolldatei des Crons liegt NEBEN dem Ordner, nicht darin
# (cron/cron.01min legt sie an, wenn log/plugins/<ordner> fehlt) - rm -rf auf
# den Ordner trifft sie deshalb nicht. Bis 1.1.3 blieb sie liegen.
if [ -f "/tmp/$PDIR-cron.log" ]; then
    rm -f "/tmp/$PDIR-cron.log" && echo "<OK> Cron-Protokoll /tmp/$PDIR-cron.log entfernt."
fi
# Bis 1.0.14 lag er unabhaengig vom Ordnernamen fest unter /tmp/saugrobo.
# Seit 1.1.0 ist das aber der laufende Zwischenspeicher einer Installation
# namens saugrobo - er bleibt, solange es sie gibt (bis 1.1.9 raeumte die
# Deinstallation von saugrobo_01 ihn ab; in WSL gemessen,
# Pruefung-Saugroboter-Valetudo-1.1.10, Fall N7).
if [ "$PDIR" != "saugrobo" ] && [ -d "/tmp/saugrobo" ] \
   && [ ! -d "$BASE/webfrontend/html/plugins/saugrobo" ]; then
    rm -rf "/tmp/saugrobo" && echo "<OK> Alter Zwischenspeicher /tmp/saugrobo entfernt."
fi

echo "<INFO> Valetudo laeuft auf dem Roboter selbst und bleibt unberuehrt."
exit 0
